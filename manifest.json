{
  "manifest_version": 3,
  "name": "Digger",
  "version": "1.23.0",
  "description": "Digging für Soundeo & SoundCloud: Charts, Preview-Tempo, Title-Filter, Artists.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": [
    "https://soundeo.com/*",
    "https://soundcloud.com/*",
    "https://*.soundcloud.com/*",
    "https://fervent-panini.93-90-203-17.plesk.page/digger-api/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Digger",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://soundeo.com/*"],
      "js": ["shared/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://soundeo.com/*"],
      "js": [
        "genres.js",
        "shared/match-modal.js",
        "shared/client-log-content.js",
        "shared/listen-behavior.js",
        "shared/rating-content.js",
        "platforms/soundeo/core.js",
        "platforms/soundeo/genres.js",
        "platforms/soundeo/overlay.js",
        "platforms/soundeo/tracks.js",
        "platforms/soundeo/rating.js",
        "platforms/soundeo/artist-tracks.js",
        "platforms/soundeo/label-tracks.js",
        "platforms/soundeo/boot.js"
      ],
      "css": ["platforms/soundeo/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": ["shared/page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://soundcloud.com/*",
        "https://*.soundcloud.com/*"
      ],
      "js": [
        "shared/match-modal.js",
        "shared/client-log-content.js",
        "shared/listen-behavior.js",
        "shared/rating-content.js",
        "platforms/soundcloud/perf.js",
        "platforms/soundcloud/core.js",
        "platforms/soundcloud/plays.js",
        "platforms/soundcloud/listened.js",
        "platforms/soundcloud/want.js",
        "platforms/soundcloud/rating.js",
        "platforms/soundcloud/autoload.js",
        "platforms/soundcloud/ui.js",
        "platforms/soundcloud/debug.js",
        "platforms/soundcloud/boot.js"
      ],
      "css": ["platforms/soundcloud/content.css"],
      "run_at": "document_idle"
    }
  ]
}
